# =============================================================================
# Sistema Pollo — variables de entorno (copiar a .env.local)
# Nunca subas claves reales a git. En Vercel: Project → Settings → Environment Variables
# =============================================================================

# --- Supabase (Project Settings → API) ---
# URL del proyecto, ej: https://xxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co

# Publishable key (nombre nuevo en el dashboard de Supabase). Preferida.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your_supabase_publishable_key_here

# Compatibilidad: si solo tienes la key "anon" antigua, puedes usar esta en su lugar.
# El código acepta PUBLISHABLE_KEY primero, luego ANON_KEY.
# NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key_here

# service_role / secret — SOLO servidor (reset passwords). NUNCA en el cliente.
# Settings → API → service_role (o secret key según el dashboard).
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key_here

# --- App ---
# URL pública (local o Vercel). Útil para redirects de auth.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Zona horaria de negocio (referencia; lógica de fechas usará America/La_Paz)
NEXT_PUBLIC_BUSINESS_TZ=America/La_Paz
