# =============================================================================
# Sistema Pollo — variables de entorno (copiar a .env.local)
# Nunca subas claves reales a git. En Vercel: Project → Settings → Environment Variables
# =============================================================================

# --- Supabase (Project Settings → API) ---
# URL del proyecto, ej: https://xxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co

# anon / public key (segura para el browser si RLS está bien configurado)
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key_here

# service_role key — SOLO servidor (reset passwords, admin). NUNCA en el cliente.
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key_here

# --- App ---
# URL pública (local o Vercel). Útil para redirects de auth.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Zona horaria de negocio (referencia; lógica de fechas usará America/La_Paz)
NEXT_PUBLIC_BUSINESS_TZ=America/La_Paz
