generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id                  String          @id @default(cuid())
  nombre              String
  email               String          @unique
  passwordHash        String
  rol                 String
  activo              Boolean         @default(true)
  foto                String?
  googleCalendarToken String?
  createdAt           DateTime        @default(now())
  updatedAt           DateTime        @updatedAt
  services            BarberService[]
  appointments        Appointment[]
  blocks              Block[]
}

model Service {
  id              String               @id @default(cuid())
  nombre          String
  descripcion     String               @default("")
  duracionMin     Int
  precio          Int
  activo          Boolean              @default(true)
  cuentaFidelidad Boolean              @default(true)
  barbers         BarberService[]
  lines           AppointmentService[]
}

model BarberService {
  userId    String
  serviceId String
  user      User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  service   Service @relation(fields: [serviceId], references: [id], onDelete: Cascade)

  @@id([userId, serviceId])
}

model Product {
  id           String         @id @default(cuid())
  nombre       String
  descripcion  String         @default("")
  precioVenta  Int
  costo        Int
  stock        Int
  stockBajo    Int            @default(3)
  foto         String?
  activo       Boolean        @default(true)
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt
  priceHistory PriceHistory[]
}

model PriceHistory {
  id          String   @id @default(cuid())
  productId   String
  product     Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  precioVenta Int
  costo       Int
  createdAt   DateTime @default(now())
}

model Client {
  id                      String        @id @default(cuid())
  nombre                  String
  apellido                String
  telefono                String        @unique
  email                   String?
  visitasTotales          Int           @default(0)
  cortesGratisDisponibles Int           @default(0)
  createdAt               DateTime      @default(now())
  appointments            Appointment[]
}

model Appointment {
  id              String               @id @default(cuid())
  publicToken     String               @unique
  clientId        String
  client          Client               @relation(fields: [clientId], references: [id])
  barberId        String
  barber          User                 @relation(fields: [barberId], references: [id])
  fecha           String
  horaInicio      String
  horaFin         String
  estado          String
  metodoPago      String
  estadoPago      String
  comprobanteUrl  String?
  googleEventId   String?
  origen          String               @default("web")
  notas           String               @default("")
  loyaltyApplied  Boolean              @default(false)
  freeCutConsumed Boolean              @default(false)
  createdAt       DateTime             @default(now())
  updatedAt       DateTime             @updatedAt
  services        AppointmentService[]

  @@index([fecha, barberId])
  @@index([estadoPago])
}

model AppointmentService {
  appointmentId   String
  serviceId       String
  nombre          String
  precio          Int
  duracionMin     Int
  cuentaFidelidad Boolean
  appointment     Appointment @relation(fields: [appointmentId], references: [id], onDelete: Cascade)
  service         Service     @relation(fields: [serviceId], references: [id])

  @@id([appointmentId, serviceId])
}

model Block {
  id          String  @id @default(cuid())
  barberId    String
  barber      User    @relation(fields: [barberId], references: [id], onDelete: Cascade)
  fechaInicio String
  fechaFin    String
  horaInicio  String?
  horaFin     String?
  motivo      String  @default("")

  @@index([barberId, fechaInicio])
}

model Settings {
  id              Int      @id @default(1)
  shopName        String
  tagline         String
  whatsappNumber  String
  whatsappMessage String
  qrImageUrl      String?
  loyaltyEveryN   Int      @default(5)
  slotMinutes     Int      @default(30)
  timezone        String   @default("America/La_Paz")
  hoursJson       String
  updatedAt       DateTime @updatedAt
}
